# Test double for systemctl. Records enable/start state under FAKE_SYSTEMCTL_STATE so a
# check script run later in the same container observes what the install script did.
#
# Set FAKE_SYSTEMCTL_ENABLE_FAIL=1 to make `enable` fail.

set -euo pipefail

STATE_DIR="${FAKE_SYSTEMCTL_STATE:-/tmp/fake-systemctl}"
mkdir -p "${STATE_DIR}"

verb=""
unit=""
prop=""
expect_prop=false
for arg in "$@"; do
    if "${expect_prop}"; then
        prop="${arg}"
        expect_prop=false
        continue
    fi
    case "${arg}" in
        -p) expect_prop=true; continue ;;
        --*) continue ;;
    esac
    if [[ -z "${verb}" ]]; then
        verb="${arg}"
    elif [[ -z "${unit}" ]]; then
        unit="${arg}"
    fi
done

echo "${verb} ${unit}" >> "${STATE_DIR}/calls"

case "${verb}" in
    daemon-reload)
        touch "${STATE_DIR}/daemon-reloaded"
        # Snapshot each installed unit's drop-ins so `show` reflects what was on disk at
        # reload time, not edits made since.
        for marker in "${STATE_DIR}"/installed.*; do
            [[ -e "${marker}" ]] || continue
            name="${marker##*/installed.}"
            snapshot="${STATE_DIR}/dropins.${name}"
            : > "${snapshot}"
            for conf in "/etc/systemd/system/${name}.d"/*.conf; do
                [[ -f "${conf}" ]] && cat "${conf}" >> "${snapshot}"
            done
        done
        ;;
    enable)
        [[ "${FAKE_SYSTEMCTL_ENABLE_FAIL:-0}" == "1" ]] && exit 1
        touch "${STATE_DIR}/enabled.${unit}"
        # `enable --now` also starts the unit.
        for arg in "$@"; do
            [[ "${arg}" == "--now" ]] && touch "${STATE_DIR}/active.${unit}"
        done
        ;;
    disable)
        rm -f "${STATE_DIR}/enabled.${unit}"
        # `disable --now` also stops the unit.
        for arg in "$@"; do
            [[ "${arg}" == "--now" ]] && rm -f "${STATE_DIR}/active.${unit}"
        done
        ;;
    start | restart)
        # prepare_nvidia_profiles.sh restarts tuned after rewriting tuned-main.conf, so
        # restart must be modelled or that script would trip the default branch below.
        touch "${STATE_DIR}/active.${unit}"
        ;;
    stop)
        rm -f "${STATE_DIR}/active.${unit}"
        ;;
    reset-failed)
        # Clears failed state. Accepts a glob, matching how the teardown calls it.
        for marker in "${STATE_DIR}"/failed.*; do
            [[ -e "${marker}" ]] || continue
            name="${marker##*/}"; name="${name#failed.}"
            # shellcheck disable=SC2053
            [[ -z "${unit}" || "${name}" == ${unit} ]] && rm -f "${marker}"
        done
        ;;
    is-enabled)
        if [[ -f "${STATE_DIR}/enabled.${unit}" ]]; then
            echo "enabled"
        else
            echo "disabled"
            exit 1
        fi
        ;;
    is-active)
        if [[ -f "${STATE_DIR}/active.${unit}" ]]; then
            echo "active"
        else
            echo "inactive"
            exit 3
        fi
        ;;
    status)
        echo "fake status for ${unit}"
        ;;
    show)
        # Supports `show -p <prop> --value <unit>` for the properties the scripts read.
        # A unit is installed when an installed.<unit> marker exists. The stack limits
        # resolve the way systemd does: the last LimitSTACK= across the unit's drop-ins
        # in lexical order wins, read from disk as of the most recent daemon-reload.
        case "${prop}" in
            LoadState)
                if [[ -f "${STATE_DIR}/installed.${unit}" ]]; then
                    echo "loaded"
                else
                    echo "not-found"
                fi
                ;;
            LimitSTACK | LimitSTACKSoft)
                hard="infinity"
                soft="8388608"
                snapshot="${STATE_DIR}/dropins.${unit}"
                if [[ -f "${snapshot}" ]]; then
                    value="$(sed -n 's/^LimitSTACK=//p' "${snapshot}" | tail -n 1)"
                    if [[ -n "${value}" ]]; then
                        hard="${value}"
                        soft="${value}"
                    fi
                fi
                if [[ "${prop}" == "LimitSTACK" ]]; then echo "${hard}"; else echo "${soft}"; fi
                ;;
            *)
                echo "fake systemctl: unsupported property '${prop}' for show" >&2
                exit 64
                ;;
        esac
        ;;
    list-unit-files)
        # `unit` holds the glob the caller passed, e.g. 'k3s-*.service'. Lists every
        # installed unit file that matches, one per line with its state; callers take
        # field 1. Like systemd, exits 1 when nothing matches.
        matched=false
        for marker in "${STATE_DIR}"/installed.*; do
            [[ -e "${marker}" ]] || continue
            name="${marker##*/installed.}"
            # shellcheck disable=SC2053
            if [[ -z "${unit}" || "${name}" == ${unit} ]]; then
                echo "${name} enabled enabled"
                matched=true
            fi
        done
        "${matched}" || exit 1
        ;;
    list-units)
        # `unit` holds the glob the caller passed, e.g. 'doca-spcx-cc@*.service'.
        # Emit one unit name per line; callers take field 1.
        seen=""
        for marker in "${STATE_DIR}"/enabled.* "${STATE_DIR}"/active.* "${STATE_DIR}"/stub.*; do
            [[ -e "${marker}" ]] || continue
            name="${marker##*/}"
            # A stub.<unit> marker models what systemd lists after the unit file is
            # removed: the instance is still enumerated under --all, but LOAD reads
            # not-found. That residue is what a successful uninstall leaves behind.
            case "${name}" in
                stub.*) load="not-found inactive dead" ;;
                *) load="loaded active running" ;;
            esac
            name="${name#enabled.}"
            name="${name#active.}"
            name="${name#stub.}"
            case " ${seen} " in *" ${name} "*) continue ;; esac
            seen="${seen} ${name}"
            # Glob matching on the right-hand side is the point: callers pass a
            # pattern such as 'doca-spcx-cc@*.service'.
            # shellcheck disable=SC2053
            if [[ -z "${unit}" || "${name}" == ${unit} ]]; then
                echo "${name} ${load} fake unit"
            fi
        done
        ;;
    *)
        # Fail loudly rather than silently succeeding. A double that returns 0 for an
        # unmodelled verb would let a script appear to work while doing nothing.
        echo "fake systemctl: unsupported command '${verb}' (unit '${unit}')" >&2
        exit 64
        ;;
esac

exit 0
