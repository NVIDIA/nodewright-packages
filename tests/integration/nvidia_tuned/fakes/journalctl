# Test double for journalctl, scoped to what the congestion control check reads.
#
# Accepts `-u <unit>` or `_SYSTEMD_INVOCATION_ID=<id>`, the ID being what the fake
# systemctl reports for a running unit. Emits the daemon's readiness line only once that
# unit is marked active by the fake systemctl. Set FAKE_JOURNAL_NEVER_READY=1 to model a
# daemon that starts but never reports ready, which is the case the check must not
# silently pass.
#
# A stale.<unit> marker models a persistent journal holding a readiness line from an
# earlier run: `-u` returns it, but a query for the current invocation does not.

set -euo pipefail

STATE_DIR="${FAKE_SYSTEMCTL_STATE:-/tmp/fake-systemctl}"

unit=""
invocation=""
prev=""
for arg in "$@"; do
    [[ "${prev}" == "-u" ]] && unit="${arg}"
    case "${arg}" in
        _SYSTEMD_INVOCATION_ID=*) invocation="${arg#_SYSTEMD_INVOCATION_ID=}" ;;
    esac
    prev="${arg}"
done

if [[ -n "${invocation}" ]]; then
    unit="${invocation#inv-}"
elif [[ -z "${unit}" ]]; then
    # Fail loudly rather than returning empty output for an unmodelled invocation.
    echo "fake journalctl: expected -u <unit> or _SYSTEMD_INVOCATION_ID=<id>" >&2
    exit 64
fi

device="${unit#*@}"
device="${device%.service}"

if [[ -z "${invocation}" && -e "${STATE_DIR}/stale.${unit}" ]]; then
    echo "PCC host status Active on ${device} (previous run)"
fi
[[ -e "${STATE_DIR}/active.${unit}" ]] || exit 0
[[ "${FAKE_JOURNAL_NEVER_READY:-0}" == "1" ]] && exit 0

echo "PCC host status Active on ${device}"
