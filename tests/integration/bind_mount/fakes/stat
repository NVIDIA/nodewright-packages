set -euo pipefail

path="${!#}"
if [[ "${FAKE_TARGET_ACTIVE:-false}" == "true" ]]; then
    if [[ "${path}" == "${FAKE_SOURCE}" ]]; then
        printf '42:1\n'
        exit 0
    fi
    if [[ "${path}" == "${FAKE_TARGET}" ]]; then
        if [[ "${FAKE_SAME_INODE:-true}" == "true" ]]; then
            printf '42:1\n'
        else
            printf '42:2\n'
        fi
        exit 0
    fi
fi

exec /usr/bin/stat "$@"
