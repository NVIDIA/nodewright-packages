set -euo pipefail

original=("$@")
lock_mode=""
timeout=""
conflict_exit_code=""

while (($# > 0)); do
    case "$1" in
        -s|-x)
            lock_mode="$1"
            shift
            ;;
        -w)
            (($# >= 2)) || { echo "fake flock: missing timeout" >&2; exit 2; }
            timeout="$2"
            shift 2
            ;;
        -E)
            (($# >= 2)) || { echo "fake flock: missing conflict exit code" >&2; exit 2; }
            conflict_exit_code="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [[ "${FAKE_FLOCK_TIMEOUT_MODE:-}" == "${lock_mode}" ]]; then
    [[ "${timeout}" == "30" ]] || {
        echo "fake flock: expected a 30-second timeout, got '${timeout}'" >&2
        exit 2
    }
    [[ "${conflict_exit_code}" == "75" ]] || {
        echo "fake flock: expected conflict exit code 75, got '${conflict_exit_code}'" >&2
        exit 2
    }
    exit "${conflict_exit_code}"
fi

exec /usr/bin/flock "${original[@]}"
