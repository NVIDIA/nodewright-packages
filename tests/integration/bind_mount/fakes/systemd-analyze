set -euo pipefail

[[ "$#" == 2 && "$1" == "verify" ]] || {
    echo "fake systemd-analyze: expected 'verify <unit>'" >&2
    exit 2
}
[[ "${2##*/}" == *.mount ]] || {
    echo "fake systemd-analyze: mount unit must have a .mount basename" >&2
    exit 2
}
if [[ -n "${FAKE_VERIFY_DELAY:-}" ]]; then
    if [[ -n "${FAKE_VERIFY_STARTED_FILE:-}" ]]; then
        : >"${FAKE_VERIFY_STARTED_FILE}"
    fi
    sleep "${FAKE_VERIFY_DELAY}"
fi
[[ "${FAKE_VERIFY_FAIL:-false}" != "true" ]]
