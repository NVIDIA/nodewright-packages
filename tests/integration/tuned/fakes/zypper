# Test wrapper for zypper: runs the real zypper, then replaces its exit code
# with FAKE_ZYPPER_EXIT when that is set, to model zypper's informational exit
# codes (106 repos skipped, 107 RPM scriptlet failed) that are hard to provoke
# in a container. Set FAKE_ZYPPER_SKIP_REAL=1 to not run the real zypper, so
# nothing gets installed.

set -euo pipefail

rc=0
if [[ "${FAKE_ZYPPER_SKIP_REAL:-0}" != "1" ]]; then
    /usr/bin/zypper "$@" || rc=$?
fi
exit "${FAKE_ZYPPER_EXIT:-${rc}}"
